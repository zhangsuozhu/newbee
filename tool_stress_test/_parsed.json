[{"no":1,"hash":"c23e17f6","content":" defmodule Newbee do"},{"no":2,"hash":"c5f0ba48","content":"   @moduledoc \"\"\""},{"no":3,"hash":"afc1a3e1","content":"   统一寻址读取 (DESIGN §3.2)：`Newbee.read/1` 通吃文件、目录、URL 与内部 scheme。"},{"no":4,"hash":"9d12a2f0","content":"   只教模型一个接口。"},{"no":5,"hash":"d41d8cd9","content":" "},{"no":6,"hash":"f88ef70e","content":"   scheme 一览:"},{"no":7,"hash":"f9428741","content":"     - 裸路径        → 文件或目录"},{"no":8,"hash":"e67d0172","content":"     - `file://`     → 文件"},{"no":9,"hash":"f4883cd8","content":"     - `tool://M`    → 模块文档（@moduledoc + 公开函数 @doc）"},{"no":10,"hash":"f3ba8ef9","content":"     - `rules://`    → 沉睡规则清单"},{"no":11,"hash":"c5915e1f","content":"     - `memory://k`  → 全局记忆条目"},{"no":12,"hash":"87ac341f","content":"     - `bindings://` → 求值器绑定摘要"},{"no":13,"hash":"0c5f1a87","content":"     - `history://`  → 本会话压缩档案（索引 / `s/<段>` 摘要 / `s/<段>/raw` 原文 /"},{"no":14,"hash":"be1c7988","content":"                  `q/<关键词>` 全文检索 / `files` 文件清单）——被压缩的对话随时可拉回"},{"no":15,"hash":"2146221d","content":"     - `events://`   → 事件日志（可选 ?n= 条数）"},{"no":16,"hash":"7531c6f5","content":"     - `skill://n`   → 技能片段（~/.newbee/skills 或工程 .newbee/skills）"},{"no":17,"hash":"18726325","content":"     - `agent://<id>/<path>` → 子代理结果按路径抠字段"},{"no":18,"hash":"a42f8858","content":"     - `conflict://` → git 合并冲突清单；`conflict://<file>` 冲突块视图"},{"no":19,"hash":"ce881e00","content":"     - `http(s)://`  → 网页（Req 拉取）"},{"no":20,"hash":"44693c55","content":"   \"\"\""},{"no":21,"hash":"d41d8cd9","content":" "},{"no":22,"hash":"1a935516","content":"   @doc \"\"\""},{"no":23,"hash":"7bafb5d1","content":"   统一读取。返回 {:ok, content} | {:error, reason}。"},{"no":24,"hash":"d41d8cd9","content":" "},{"no":25,"hash":"f26e952c","content":"     - 目录 → 一层列表（目录名带 / 后缀）"},{"no":26,"hash":"200e8b25","content":"     - 文件 → 文本内容（≤512KB，超出截断并标注）"},{"no":27,"hash":"09c96c7d","content":"     - URL → 网页文本"},{"no":28,"hash":"081f4515","content":"     - 内部 scheme → 见 @moduledoc"},{"no":29,"hash":"44693c55","content":"   \"\"\""},{"no":30,"hash":"a70c40f9","content":"   def read(path) when is_binary(path) do"},{"no":31,"hash":"91c9bfaf","content":"     cond do"},{"no":32,"hash":"f6055965","content":"       String.starts_with?(path, \"tool://\") ->"},{"no":33,"hash":"3d69efa4","content":"         read_tool(String.trim_leading(path, \"tool://\"))"},{"no":34,"hash":"d41d8cd9","content":" "},{"no":35,"hash":"8ea768a2","content":"       path == \"rules://\" or String.starts_with?(path, \"rules://\") ->"},{"no":36,"hash":"96b4d5c5","content":"         read_rules()"},{"no":37,"hash":"d41d8cd9","content":" "},{"no":38,"hash":"bcfdbb77","content":"       String.starts_with?(path, \"memory://\") ->"},{"no":39,"hash":"93822f05","content":"         read_memory(String.trim_leading(path, \"memory://\"))"},{"no":40,"hash":"d41d8cd9","content":" "},{"no":41,"hash":"15a57b9c","content":"       String.starts_with?(path, \"skill://\") ->"},{"no":42,"hash":"606f7945","content":"         read_skill(String.trim_leading(path, \"skill://\"))"},{"no":43,"hash":"d41d8cd9","content":" "},{"no":44,"hash":"632bd5e5","content":"       String.starts_with?(path, \"agent://\") ->"},{"no":45,"hash":"87a28384","content":"         read_agent(String.trim_leading(path, \"agent://\"))"},{"no":46,"hash":"d41d8cd9","content":" "},{"no":47,"hash":"07be8975","content":"       path == \"conflict://\" or String.starts_with?(path, \"conflict://\") ->"},{"no":48,"hash":"87c6ea1f","content":"         read_conflict(String.trim_leading(path, \"conflict://\"))"},{"no":49,"hash":"d41d8cd9","content":" "},{"no":50,"hash":"10b4dfdd","content":"       path == \"bindings://\" ->"},{"no":51,"hash":"b5772287","content":"         read_bindings()"},{"no":52,"hash":"d41d8cd9","content":" "},{"no":53,"hash":"830af0ce","content":"       # history:// 经 Host.call 回主节点执行：peer 求值节点上的模型代码同样可用"},{"no":54,"hash":"c5a5c1db","content":"       path == \"history://\" or String.starts_with?(path, \"history://\") ->"},{"no":55,"hash":"d3754204","content":"         Newbee.Host.call(Newbee.Archive, :read_history, [String.trim_leading(path, \"history://\")])"},{"no":56,"hash":"d41d8cd9","content":" "},{"no":57,"hash":"c883b5b6","content":"       String.starts_with?(path, \"events://\") ->"},{"no":58,"hash":"91fb53b2","content":"         read_events(String.trim_leading(path, \"events://\"))"},{"no":59,"hash":"d41d8cd9","content":" "},{"no":60,"hash":"6aa36a47","content":"       String.starts_with?(path, \"http://\") or String.starts_with?(path, \"https://\") ->"},{"no":61,"hash":"e3a3d34d","content":"         read_url(path)"},{"no":62,"hash":"d41d8cd9","content":" "},{"no":63,"hash":"1afaa9e2","content":"       String.starts_with?(path, \"file://\") ->"},{"no":64,"hash":"7452a072","content":"         read_path(String.trim_leading(path, \"file://\"))"},{"no":65,"hash":"d41d8cd9","content":" "},{"no":66,"hash":"fb30cfb1","content":"       true ->"},{"no":67,"hash":"1a238b49","content":"         read_path(path)"},{"no":68,"hash":"d29af5fc","content":"     end"},{"no":69,"hash":"157f0a46","content":"   end"},{"no":70,"hash":"d41d8cd9","content":" "},{"no":71,"hash":"e73be222","content":"   def read(_), do: {:error, :invalid_path}"},{"no":72,"hash":"d41d8cd9","content":" "},{"no":73,"hash":"5d7ffc57","content":"   # ── 各实现 ──"},{"no":74,"hash":"d41d8cd9","content":" "},{"no":75,"hash":"68acc588","content":"   defp read_path(path) do"},{"no":76,"hash":"35cc7b26","content":"     if sensitive_path?(path) do"},{"no":77,"hash":"f9eba0c0","content":"       {:ok,"},{"no":78,"hash":"db8d8829","content":"        \"[REDACTED: sensitive file — use Newbee.Host.safe_config/0 for model config or inspect env directly; raw content withheld]\"}"},{"no":79,"hash":"e46f8490","content":"     else"},{"no":80,"hash":"cd77ea63","content":"       cond do"},{"no":81,"hash":"0ffc562e","content":"         File.regular?(path) ->"},{"no":82,"hash":"75f0e992","content":"           case File.read(path) do"},{"no":83,"hash":"b39841d9","content":"             {:ok, body} when byte_size(body) <= 512 * 1024 ->"},{"no":84,"hash":"f3625bd4","content":"               {:ok, Newbee.Trust.envelope(body, \"file:\" <> path) |> Newbee.Trust.render()}"},{"no":85,"hash":"d41d8cd9","content":" "},{"no":86,"hash":"88229796","content":"             {:ok, body} ->"},{"no":87,"hash":"46ec7844","content":"               truncated ="},{"no":88,"hash":"b6cace52","content":"                 binary_part(body, 0, 512 * 1024) <>"},{"no":89,"hash":"882fe2d2","content":"                   \"\\n… [截断: #{byte_size(body)} bytes > 512KB，用 Fs 分段读取] …\\n\""},{"no":90,"hash":"d41d8cd9","content":" "},{"no":91,"hash":"f6ae7624","content":"               {:ok, Newbee.Trust.envelope(truncated, \"file:\" <> path) |> Newbee.Trust.render()}"},{"no":92,"hash":"d41d8cd9","content":" "},{"no":93,"hash":"6661e81e","content":"             {:error, reason} ->"},{"no":94,"hash":"9f0cc0b4","content":"               {:error, reason}"},{"no":95,"hash":"2beff17a","content":"           end"},{"no":96,"hash":"d41d8cd9","content":" "},{"no":97,"hash":"1bf3bc72","content":"         File.dir?(path) ->"},{"no":98,"hash":"0eb2f50a","content":"           {:ok, Newbee.Tools.Fs.ls(path) |> Enum.join(\"\\n\")}"},{"no":99,"hash":"d41d8cd9","content":" "},{"no":100,"hash":"5ac9f1fd","content":"         true ->"},{"no":101,"hash":"0b1ca880","content":"           {:error, :enoent}"},{"no":102,"hash":"4e48e167","content":"       end"},{"no":103,"hash":"d29af5fc","content":"     end"},{"no":104,"hash":"157f0a46","content":"   end"},{"no":105,"hash":"d41d8cd9","content":" "},{"no":106,"hash":"e44d5051","content":"   @sensitive_re ~r/(model\\.json|\\.env|api[_-]?key|secret|token)/i"},{"no":107,"hash":"d6e128d4","content":"   defp sensitive_path?(path) do"},{"no":108,"hash":"4087e845","content":"     base = Path.basename(path)"},{"no":109,"hash":"d41d8cd9","content":" "},{"no":110,"hash":"386a9af1","content":"     Regex.match?(@sensitive_re, base) or String.contains?(path, \".newbee/model.json\") or"},{"no":111,"hash":"d6e72313","content":"       String.contains?(path, \".newbee/config.json\")"},{"no":112,"hash":"157f0a46","content":"   end"},{"no":113,"hash":"d41d8cd9","content":" "},{"no":114,"hash":"5e21d69a","content":"   # skill://：技能片段（全局 ~/.newbee/skills 优先，再工程 .newbee/skills）"},{"no":115,"hash":"091f0ac8","content":"   defp read_skill(name) do"},{"no":116,"hash":"067e2353","content":"     candidates = ["},{"no":117,"hash":"c9582071","content":"       Path.join([System.user_home!(), \".newbee\", \"skills\", name <> \".md\"]),"},{"no":118,"hash":"71344aa7","content":"       Path.join([File.cwd!(), \".newbee\", \"skills\", name <> \".md\"])"},{"no":119,"hash":"6b3c75df","content":"     ]"},{"no":120,"hash":"d41d8cd9","content":" "},{"no":121,"hash":"baa081ba","content":"     case Enum.find(candidates, &File.regular?/1) do"},{"no":122,"hash":"d2772d3a","content":"       nil -> {:error, :skill_not_found}"},{"no":123,"hash":"6fd8596d","content":"       path -> {:ok, File.read!(path)}"},{"no":124,"hash":"d29af5fc","content":"     end"},{"no":125,"hash":"157f0a46","content":"   end"},{"no":126,"hash":"d41d8cd9","content":" "},{"no":127,"hash":"3980f6f1","content":"   # agent://<id>/<path>：子代理结构化结果按路径抠字段（§3.8）"},{"no":128,"hash":"e5519868","content":"   defp read_agent(query) do"},{"no":129,"hash":"4a430501","content":"     case String.split(query, \"/\", parts: 2) do"},{"no":130,"hash":"ce25574b","content":"       [id, path] ->"},{"no":131,"hash":"a50af529","content":"         file = Path.join([System.user_home!(), \".newbee\", \"agents\", id, \"result.json\"])"},{"no":132,"hash":"d41d8cd9","content":" "},{"no":133,"hash":"fb1940c5","content":"         case File.read(file) do"},{"no":134,"hash":"66eca113","content":"           {:ok, body} ->"},{"no":135,"hash":"177ea849","content":"             case Jason.decode(body) do"},{"no":136,"hash":"36b64ad1","content":"               {:ok, value} ->"},{"no":137,"hash":"018d076c","content":"                 case Newbee.Tools.Json.get(value, path) do"},{"no":138,"hash":"c445b293","content":"                   {:ok, v} -> {:ok, inspect(v, pretty: true, limit: 50)}"},{"no":139,"hash":"954e3a5e","content":"                   :error -> {:error, :path_not_found}"},{"no":140,"hash":"f07dc8af","content":"                 end"},{"no":141,"hash":"d41d8cd9","content":" "},{"no":142,"hash":"bb0ccda7","content":"               {:error, e} ->"},{"no":143,"hash":"922d9572","content":"                 {:error, {:bad_json, e}}"},{"no":144,"hash":"c2b706d2","content":"             end"},{"no":145,"hash":"d41d8cd9","content":" "},{"no":146,"hash":"2ac5e1d0","content":"           _ ->"},{"no":147,"hash":"399b2325","content":"             {:error, :agent_not_found}"},{"no":148,"hash":"7461c354","content":"         end"},{"no":149,"hash":"d41d8cd9","content":" "},{"no":150,"hash":"de5c4911","content":"       [id] ->"},{"no":151,"hash":"65e40f6e","content":"         read_agent(id <> \"/findings\")"},{"no":152,"hash":"d29af5fc","content":"     end"},{"no":153,"hash":"157f0a46","content":"   end"},{"no":154,"hash":"d41d8cd9","content":" "},{"no":155,"hash":"dd47adcd","content":"   # conflict://：git 合并冲突。裸查询列冲突文件；带文件路径渲染冲突块视图"},{"no":156,"hash":"0c34b9f4","content":"   defp read_conflict(\"\") do"},{"no":157,"hash":"16df5adc","content":"     case System.cmd(\"git\", [\"diff\", \"--name-only\", \"--diff-filter=U\"], stderr_to_stdout: true) do"},{"no":158,"hash":"330637d3","content":"       {out, 0} ->"},{"no":159,"hash":"c144ce42","content":"         files = out |> String.split(\"\\n\", trim: true)"},{"no":160,"hash":"d41d8cd9","content":" "},{"no":161,"hash":"c06d60cf","content":"         if files == [] do"},{"no":162,"hash":"6b4b2e82","content":"           {:ok, \"（当前无合并冲突）\"}"},{"no":163,"hash":"3554baa9","content":"         else"},{"no":164,"hash":"42076ea6","content":"           {:ok, Enum.map_join(files, \"\\n\", &\"conflict://#{&1}\")}"},{"no":165,"hash":"7461c354","content":"         end"},{"no":166,"hash":"d41d8cd9","content":" "},{"no":167,"hash":"fc4b2a67","content":"       _ ->"},{"no":168,"hash":"5693790c","content":"         {:ok, \"（非 git 仓库或 git 不可用）\"}"},{"no":169,"hash":"d29af5fc","content":"     end"},{"no":170,"hash":"157f0a46","content":"   end"},{"no":171,"hash":"d41d8cd9","content":" "},{"no":172,"hash":"1f70efb6","content":"   defp read_conflict(path) do"},{"no":173,"hash":"df0fa5df","content":"     case File.read(path) do"},{"no":174,"hash":"7ca64bb3","content":"       {:ok, body} ->"},{"no":175,"hash":"c8a0e0ce","content":"         # 冲突块：<<<<<<< ours / ======= / >>>>>>> theirs"},{"no":176,"hash":"eabb9546","content":"         blocks ="},{"no":177,"hash":"8b5b2660","content":"           body"},{"no":178,"hash":"1f831ad4","content":"           |> String.split(\"<<<<<<<\")"},{"no":179,"hash":"987071ae","content":"           |> Enum.drop(1)"},{"no":180,"hash":"5b0e0a42","content":"           |> Enum.map(fn chunk ->"},{"no":181,"hash":"7ffb6a4d","content":"             [ours, rest] = String.split(chunk, \"=======\", parts: 2)"},{"no":182,"hash":"d92ad1bb","content":"             [theirs | _] = String.split(rest, \">>>>>>>\", parts: 2)"},{"no":183,"hash":"dfdaa53a","content":"             \"┌─ @ours\\n\" <> ours <> \"└─ @theirs\\n\" <> theirs"},{"no":184,"hash":"a1b9c919","content":"           end)"},{"no":185,"hash":"d41d8cd9","content":" "},{"no":186,"hash":"7d0ebe34","content":"         if blocks == [] do"},{"no":187,"hash":"ba130f00","content":"           {:ok, \"（#{path} 无冲突块）\"}"},{"no":188,"hash":"3554baa9","content":"         else"},{"no":189,"hash":"10e14ef0","content":"           {:ok, Enum.join(blocks, \"\\n\")}"},{"no":190,"hash":"7461c354","content":"         end"},{"no":191,"hash":"d41d8cd9","content":" "},{"no":192,"hash":"8eec2e63","content":"       {:error, reason} ->"},{"no":193,"hash":"387a3b11","content":"         {:error, reason}"},{"no":194,"hash":"d29af5fc","content":"     end"},{"no":195,"hash":"157f0a46","content":"   end"},{"no":196,"hash":"d41d8cd9","content":" "},{"no":197,"hash":"0d9b1c3e","content":"   defp read_rules do"},{"no":198,"hash":"b6dc308d","content":"     if Process.whereis(Newbee.DEE.Rules) do"},{"no":199,"hash":"e3352a81","content":"       case Newbee.DEE.Rules.list() do"},{"no":200,"hash":"6c6f6a1b","content":"         [] -> {:ok, \"（无沉睡规则）\"}"},{"no":201,"hash":"67fba572","content":"         rules -> {:ok, Enum.map_join(rules, \"\\n\", &\"[#{&1.id}] /#{&1.pattern}/ → #{&1.injection}\")}"},{"no":202,"hash":"4e48e167","content":"       end"},{"no":203,"hash":"e46f8490","content":"     else"},{"no":204,"hash":"c9e906c1","content":"       {:ok, \"（规则服务未启动）\"}"},{"no":205,"hash":"d29af5fc","content":"     end"},{"no":206,"hash":"157f0a46","content":"   end"},{"no":207,"hash":"d41d8cd9","content":" "},{"no":208,"hash":"b5fb7fa9","content":"   defp read_memory(key) do"},{"no":209,"hash":"80348e8c","content":"     case Newbee.Memory.read(key) do"},{"no":210,"hash":"a46949b1","content":"       {:ok, content} -> {:ok, content}"},{"no":211,"hash":"8e28886e","content":"       {:error, reason} -> {:error, reason}"},{"no":212,"hash":"d29af5fc","content":"     end"},{"no":213,"hash":"157f0a46","content":"   end"},{"no":214,"hash":"d41d8cd9","content":" "},{"no":215,"hash":"035b909b","content":"   defp read_bindings do"},{"no":216,"hash":"747d7762","content":"     if Process.whereis(Newbee.DEE.Evaluator) do"},{"no":217,"hash":"5729d204","content":"       case Newbee.DEE.Evaluator.bindings_summary() do"},{"no":218,"hash":"c53a5149","content":"         [] -> {:ok, \"（空）\"}"},{"no":219,"hash":"9f82d22c","content":"         bs -> {:ok, Enum.map_join(bs, \"\\n\", &\"#{&1.name} : #{&1.type} (#{&1.size} bytes)\")}"},{"no":220,"hash":"4e48e167","content":"       end"},{"no":221,"hash":"e46f8490","content":"     else"},{"no":222,"hash":"75dd25d5","content":"       {:ok, \"（求值器未启动）\"}"},{"no":223,"hash":"d29af5fc","content":"     end"},{"no":224,"hash":"157f0a46","content":"   end"},{"no":225,"hash":"d41d8cd9","content":" "},{"no":226,"hash":"04e7fd0e","content":"   defp read_events(query) do"},{"no":227,"hash":"f358697d","content":"     n ="},{"no":228,"hash":"f169ba73","content":"       case Regex.run(~r/[?&]n=(\\d+)/, query) do"},{"no":229,"hash":"1137a555","content":"         [_, n] -> String.to_integer(n)"},{"no":230,"hash":"9e62ebb8","content":"         _ -> 200"},{"no":231,"hash":"4e48e167","content":"       end"},{"no":232,"hash":"d41d8cd9","content":" "},{"no":233,"hash":"5952a877","content":"     # 优先项目 Event Store（唯一权威，§4.6）；无项目流时回退全局事件日志"},{"no":234,"hash":"2a0d0f48","content":"     project_events = Newbee.EventStore.replay(Newbee.Environment.Store.path(:events)) |> Enum.take(-n)"},{"no":235,"hash":"d41d8cd9","content":" "},{"no":236,"hash":"2afb05bd","content":"     if project_events != [] do"},{"no":237,"hash":"a38958a2","content":"       {:ok, Enum.map_join(project_events, \"\\n\", &\"[#{&1.topic}] ##{&1.id} #{inspect(&1.data) |> String.slice(0, 200)}\")}"},{"no":238,"hash":"e46f8490","content":"     else"},{"no":239,"hash":"a8927a85","content":"       events = Newbee.EventLog.read(n)"},{"no":240,"hash":"a44c5ae8","content":"       {:ok, Enum.map_join(events, \"\\n\", &\"[#{&1[\"topic\"]}] #{inspect(&1[\"event\"]) |> String.slice(0, 200)}\")}"},{"no":241,"hash":"d29af5fc","content":"     end"},{"no":242,"hash":"157f0a46","content":"   end"},{"no":243,"hash":"d41d8cd9","content":" "},{"no":244,"hash":"2a693a7d","content":"   # URL 读取经受控 transport（§12：域名白名单 + Host 执行网络）+ trust envelope"},{"no":245,"hash":"61f9367c","content":"   defp read_url(url) do"},{"no":246,"hash":"956ade8b","content":"     case Newbee.Host.Shell.execute_request_plan(%{url: url, method: \"get\", headers: [], body: nil}) do"},{"no":247,"hash":"6871b9c4","content":"       {:ok, body} when is_binary(body) ->"},{"no":248,"hash":"2b09400a","content":"         content = String.slice(body, 0, 512 * 1024)"},{"no":249,"hash":"357d1d86","content":"         {:ok, Newbee.Trust.envelope(content, \"url:\" <> url) |> Newbee.Trust.render()}"},{"no":250,"hash":"d41d8cd9","content":" "},{"no":251,"hash":"7ca64bb3","content":"       {:ok, body} ->"},{"no":252,"hash":"b2a3e7bd","content":"         {:ok, Newbee.Trust.envelope(inspect(body), \"url:\" <> url) |> Newbee.Trust.render()}"},{"no":253,"hash":"d41d8cd9","content":" "},{"no":254,"hash":"8eec2e63","content":"       {:error, reason} ->"},{"no":255,"hash":"387a3b11","content":"         {:error, reason}"},{"no":256,"hash":"d29af5fc","content":"     end"},{"no":257,"hash":"a1a588d6","content":"   rescue"},{"no":258,"hash":"b00a8002","content":"     _ -> {:error, :fetch_failed}"},{"no":259,"hash":"157f0a46","content":"   end"},{"no":260,"hash":"d41d8cd9","content":" "},{"no":261,"hash":"dad3994e","content":"   defp read_tool(module_name) do"},{"no":262,"hash":"8b1c86a8","content":"     # 模块名归一：tool://Newbee.Tools.Edit → :\"Elixir.Newbee.Tools.Edit\""},{"no":263,"hash":"75a8c274","content":"     module ="},{"no":264,"hash":"9d6f9d48","content":"       case module_name do"},{"no":265,"hash":"31425ec8","content":"         \"Elixir.\" <> _ -> String.to_atom(module_name)"},{"no":266,"hash":"dbb8365d","content":"         _ -> String.to_atom(\"Elixir.\" <> module_name)"},{"no":267,"hash":"4e48e167","content":"       end"},{"no":268,"hash":"d41d8cd9","content":" "},{"no":269,"hash":"098ec860","content":"     if Code.ensure_loaded?(module) do"},{"no":270,"hash":"a306fb5d","content":"       docs ="},{"no":271,"hash":"18767766","content":"         case Code.fetch_docs(module) do"},{"no":272,"hash":"eddc6c9f","content":"           {:docs_v1, _, _, _, module_doc, _, func_docs} -> {module_doc, func_docs}"},{"no":273,"hash":"bc708467","content":"           _ -> {nil, []}"},{"no":274,"hash":"7461c354","content":"         end"},{"no":275,"hash":"d41d8cd9","content":" "},{"no":276,"hash":"f9b539e2","content":"       {module_doc, func_docs} = docs"},{"no":277,"hash":"d41d8cd9","content":" "},{"no":278,"hash":"92c84c7e","content":"       # docs_v1 外层：{annotation, beam_lang, format, module_doc, metadata, docs}"},{"no":279,"hash":"b64669e7","content":"       # 函数元组：{{kind, name, arity}, annotation, signature, doc, metadata}"},{"no":280,"hash":"6b4ba831","content":"       # 文档值在 Elixir ≥1.15 是 `%{\"en\" => text}` 语言分键 map，旧版才是裸 binary；"},{"no":281,"hash":"c6fc42f2","content":"       # 只认 binary 会把所有函数 @doc 渲染成空串（模型从此对工具 API 一无所知，"},{"no":282,"hash":"91795644","content":"       # 只能瞎猜函数名，如 Fs.write 猜成 write_file）。"},{"no":283,"hash":"83028a3f","content":"       moduledoc = doc_text(module_doc)"},{"no":284,"hash":"d41d8cd9","content":" "},{"no":285,"hash":"c4ec6258","content":"       funcs ="},{"no":286,"hash":"90ef2139","content":"         func_docs"},{"no":287,"hash":"a53ffef1","content":"         |> Enum.filter(fn"},{"no":288,"hash":"246ce043","content":"           {{:function, name, _arity}, _, _, doc, _} when name not in [:__info__, :module_info] ->"},{"no":289,"hash":"da11c14f","content":"             doc_text(doc) != \"\""},{"no":290,"hash":"d41d8cd9","content":" "},{"no":291,"hash":"2ac5e1d0","content":"           _ ->"},{"no":292,"hash":"2d005b6b","content":"             false"},{"no":293,"hash":"f62e8e80","content":"         end)"},{"no":294,"hash":"668c392d","content":"         |> Enum.map_join(\"\\n\", fn {{:function, name, arity}, _, _, doc, _} ->"},{"no":295,"hash":"ea864980","content":"           \"  #{name}/#{arity}: #{String.slice(doc_text(doc), 0, 800)}\""},{"no":296,"hash":"f62e8e80","content":"         end)"},{"no":297,"hash":"d41d8cd9","content":" "},{"no":298,"hash":"1df6c47b","content":"       {:ok, \"## #{module_name}\\n\" <> moduledoc <> \"\\n\" <> funcs}"},{"no":299,"hash":"e46f8490","content":"     else"},{"no":300,"hash":"9a3b93b2","content":"       {:error, :module_not_loaded}"},{"no":301,"hash":"d29af5fc","content":"     end"},{"no":302,"hash":"a1a588d6","content":"   rescue"},{"no":303,"hash":"d7898d6e","content":"     _ -> {:error, :module_not_found}"},{"no":304,"hash":"157f0a46","content":"   end"},{"no":305,"hash":"d41d8cd9","content":" "},{"no":306,"hash":"eeb423e5","content":"   # docs_v1 文档值统一提文本：language-keyed map（%{\"en\" => …}）、{format, text} 元组、"},{"no":307,"hash":"937381d4","content":"   # 裸 binary 都收；:none/缺文档 → \"\"。"},{"no":308,"hash":"02a11cf7","content":"   defp doc_text(%{\"en\" => text}) when is_binary(text), do: text"},{"no":309,"hash":"793680a0","content":"   defp doc_text(%{\"zh\" => text}) when is_binary(text), do: text"},{"no":310,"hash":"4bee1c9c","content":"   defp doc_text({_format, text}) when is_binary(text), do: text"},{"no":311,"hash":"738b9e2d","content":"   defp doc_text(text) when is_binary(text), do: text"},{"no":312,"hash":"90486166","content":"   defp doc_text(_), do: \"\""},{"no":313,"hash":"7f021a14","content":" end"}]