#!/usr/bin/env bash
# newbee 启动脚本
# 用法：./bin/newbee [子命令] [参数]
#   ./bin/newbee            → mix newbee（CLI）
#   ./bin/newbee tui        → mix newbee.tui（全屏 TUI；自动 raw 模式 + 尺寸探测）
#   ./bin/newbee web [port] → mix newbee.web（浏览器 WebUI，默认 4173）
#   ./bin/newbee daemon     → mix newbee.daemon
#   ./bin/newbee bench      → mix newbee.bench
#   ./bin/newbee <args>     → mix newbee <args>（透传，如 ./bin/newbee -r <id>）
# 运行目录即 newbee 的工作目录：通过 NEWBEE_CWD 注入，newbee 启动时切过去。
set -euo pipefail

# 优先使用本机 toolchains 里的 OTP/Elixir
export PATH="$HOME/toolchains/otp-29/bin:$HOME/toolchains/elixir-1.20/bin:$PATH"

# 定位 newbee 工程根（脚本所在目录的上一级，脚本在 bin/ 下）
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NEWBEE_ROOT="$(dirname "$SCRIPT_DIR")"

# 用户运行目录 = 工作目录
export NEWBEE_CWD="$PWD"

cd "$NEWBEE_ROOT"

case "${1:-}" in
  tui)
    # ── 全屏 TUI：必须 raw 模式 + 真实终端尺寸 ──
    # 1) 探测尺寸（脚本层有控制终端，stty 可用）
    if SIZE="$(stty size 2>/dev/null)"; then
      export NEWBEE_ROWS="${SIZE%% *}"
      export NEWBEE_COLS="${SIZE##* }"
    else
      export NEWBEE_ROWS="${LINES:-24}"
      export NEWBEE_COLS="${COLUMNS:-100}"
    fi

    # 2) raw 模式：逐键直达 BEAM（BEAM 自身失去 ctty，无法自设）
    stty raw -echo 2>/dev/null || true

    # 3) 退出/中断时恢复终端
    restore_tty() { stty sane 2>/dev/null || true; }
    trap restore_tty EXIT INT TERM HUP

    shift
    mix newbee.tui "$@"
    STATUS=$?
    restore_tty
    exit "$STATUS"
    ;;

  daemon)
    shift
    exec mix newbee.daemon "$@"
    ;;

  attach)
    # 接回最近会话（环境记忆仍在 ~/.newbee，§3.8）
    LATEST=$(ls -t "$HOME/.newbee/sessions/"*.jsonl 2>/dev/null | head -1)
    if [ -z "$LATEST" ]; then
      echo "没有可附加的会话（~/.newbee/sessions/ 为空）"
      exit 1
    fi
    ID=$(basename "$LATEST" .jsonl)
    exec mix newbee -r "$ID"
    ;;

  web)
    # ── 浏览器 WebUI ──
    shift
    exec mix newbee.web "$@"
    ;;

  bench)
    shift
    exec mix newbee.bench "$@"
    ;;

  make)
    shift
    exec mix compile
    ;;


  "")
    exec mix newbee
    ;;

  *)
    exec mix newbee "$@"
    ;;
esac
